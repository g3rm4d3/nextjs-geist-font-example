# Copy this file to .env and fill in real (development-only) values.
# Never commit .env. Used by db:migrate / db:seed / db:reset — these are
# standalone scripts, not the API's runtime process, so they read the
# connection string independently.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rideshare_dev

# Optional. Only set this if you want db:seed to also create two dev-only
# admin accounts (super.admin@example-dev.test, admin@example-dev.test)
# with this password. There is no public admin registration endpoint by
# design, so this is the sanctioned way to get a first admin account
# locally. Leave unset to skip admin seeding entirely — never commit a
# real value here.
# SEED_ADMIN_PASSWORD=
