# Copy this file to .env and fill in real (development-only) values.
# Never commit .env. Never put real secrets in an EXPO_PUBLIC_ variable —
# it is inlined into the client bundle at build time.

EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional. Android needs a Google Maps API key to render map tiles at all
# (iOS uses Apple Maps by default and needs none). Unlike a backend
# secret, this key is *designed* to be embedded in the client — restrict
# it by Android package name + SHA-1 signing cert in Google Cloud
# Console, not by keeping it out of the bundle. Leave unset and Android
# map tiles simply won't render (see docs/maps.md) — this environment has
# no way to provision or verify a real key.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
