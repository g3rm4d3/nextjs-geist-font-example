# Copy this file to .env and fill in real (development-only) values.
# Never commit .env. Never put real secrets in this file.

NODE_ENV=development

# HTTP port the API listens on.
PORT=4000

# Origins allowed to call this API (comma-separated). Used for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL connection string.
# Local dev default matches the database created by scripts/setup steps in README.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rideshare_dev

# Set to a small pool for local development; tune per-environment in production.
DATABASE_POOL_MAX=10

# "debug" | "info" | "warn" | "error". Defaults to "debug" outside production.
LOG_LEVEL=debug

# Signs access tokens (JWT, HS256). Generate your own for local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never reuse this example value anywhere real; it is not a secret, it is
# a placeholder that will fail the >=32-char check if you forget to change it.
JWT_ACCESS_SECRET=replace-this-with-a-real-random-secret-at-least-32-chars

# How long an access token is valid for (jsonwebtoken "expiresIn" format).
JWT_ACCESS_TOKEN_TTL=15m

# How long a refresh token (and thus a "session") stays valid.
JWT_REFRESH_TOKEN_TTL_DAYS=30

# How long a password reset link/token stays valid before expiring.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Phase 8 (Matching Engine): how long a driver has to ACCEPT/DECLINE an
# offer before it's swept up as a timeout and matching moves to the next
# candidate, and how often the background sweep checks for expired offers.
MATCHING_OFFER_TIMEOUT_SECONDS=15
MATCHING_SWEEP_INTERVAL_MS=5000

# Phase 10 (Realtime Ride Experience): minimum time between persisted
# route-history samples (ride_location_samples) for a ride that's
# IN_PROGRESS — independent of, and coarser than, the fixed 2s throttle
# on updating a driver's current position.
RIDE_LOCATION_SAMPLE_INTERVAL_MS=10000

# Phase 11 (Payment Sandbox): both optional. Leave unset to use the MOCK
# PaymentProvider (the default here — this environment has no real, even
# TEST MODE, Stripe secret key it can provision or verify; see
# docs/payments.md). If you do have a Stripe TEST MODE account, set
# STRIPE_SECRET_KEY (must start with "sk_test_" — a live key is refused)
# and STRIPE_WEBHOOK_SECRET (from `stripe listen`/your webhook endpoint
# settings) to exercise the real provider. NEVER put a live secret key
# here or anywhere in this codebase.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
