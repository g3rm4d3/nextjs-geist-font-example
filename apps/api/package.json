{
  "name": "@rideshare/api",
  "version": "0.1.0",
  "private": true,
  "description": "Rideshare platform backend API. Authoritative source for ride state, fares, driver assignment, and financial calculations.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "simulate:drivers": "tsx scripts/locationSimulator.ts"
  },
  "dependencies": {
    "@rideshare/auth": "*",
    "@rideshare/database": "*",
    "@rideshare/logging": "*",
    "@rideshare/maps": "*",
    "@rideshare/pricing": "*",
    "@rideshare/types": "*",
    "@rideshare/validation": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rideshare/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
