# Copy this file to .env and fill in real (development-only) values.
# Never commit .env. Never put real secrets in an EXPO_PUBLIC_ variable —
# it is inlined into the client bundle at build time.

EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional. Android needs a Google Maps API key to render map tiles at all
# (iOS uses Apple Maps by default and needs none). See docs/maps.md.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Phase 5: "support real GPS and configurable mock GPS during
# development". Set to "true" to skip expo-location entirely and use a
# fixed (slightly drifting) coordinate instead — this environment has no
# simulator/device with a real GPS fix, so mock mode is what's actually
# exercised here. Leave unset/false on a real device or simulator with
# location configured. See src/lib/locationProvider.ts.
EXPO_PUBLIC_MOCK_GPS=true
EXPO_PUBLIC_MOCK_GPS_LAT=39.7684
EXPO_PUBLIC_MOCK_GPS_LNG=-86.158
